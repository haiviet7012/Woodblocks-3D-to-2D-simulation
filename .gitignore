# Môi trường Python
.venv/
__pycache__/
*.pyc

# Kết quả sinh ra khi chạy script / notebook (giữ outputs/.gitkeep để thư mục vẫn hiện trên repo)
outputs/*
!outputs/.gitkeep
outputs.zip

# Hình của báo cáo là output: chỉ ở máy (giữ figures/.gitkeep để thư mục vẫn hiện trên repo)
figures/*
!figures/.gitkeep

# Keep fonts, textures and other input assets; ignore only STL files.
/input/**/*.[sS][tT][lL]

# Notebook checkpoint, file hệ điều hành / editor
.ipynb_checkpoints/
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large per-run artifacts
testing_outputs/

# Offline dependency cache and local environment captures
wheelhouse/
environment.local.json
